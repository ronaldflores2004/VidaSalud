@startuml

set separator none
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam shadowing false
skinparam ArrowColor #333333
skinparam ActorBorderColor #222222
skinparam ActorBackgroundColor #FFFFFF
skinparam UsecaseBorderColor #1F4E79
skinparam UsecaseBackgroundColor #DCE9F7
skinparam PackageBorderColor #333333
skinparam PackageBackgroundColor #FFFFFF
skinparam ClassBorderColor #333333
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassHeaderBackgroundColor #DCE9F7
skinparam NoteBackgroundColor #FFF8DC
skinparam RectangleBorderColor #333333
skinparam NodeBorderColor #1F4E79
skinparam NodeBackgroundColor #F3F8FD
skinparam ArtifactBackgroundColor #FFFFFF
skinparam DatabaseBackgroundColor #DCE9F7
skinparam SequenceLifeLineBorderColor #888888
skinparam SequenceParticipantBackgroundColor #DCE9F7
skinparam SequenceParticipantBorderColor #1F4E79
skinparam ParticipantPadding 12
skinparam BoundaryBackgroundColor #DCE9F7
skinparam ControlBackgroundColor #DCE9F7
skinparam EntityBackgroundColor #DCE9F7
skinparam BoundaryBorderColor #1F4E79
skinparam ControlBorderColor #1F4E79
skinparam EntityBorderColor #1F4E79
skinparam roundcorner 8
skinparam componentStyle uml2
skinparam ComponentBackgroundColor #FFFFFF
skinparam ComponentBorderColor #1F4E79
skinparam PackageBackgroundColor #FBFBFB
skinparam ArrowColor #555555
skinparam defaultFontSize 11

skinparam ranksep 70
skinparam nodesep 25
top to bottom direction
rectangle "Capa de presentación (frontend/views)" as LF #F7FAFD {
  component "«form»\nCU4 FGestionarEspecialidades\n(index.blade.php,\nform.blade.php)" as F_CU4_0 #E3EEFB
  component "«form»\nCU5 FGestionarMedicos\n(index, form,\nshow.blade.php)" as F_CU5_0 #E3EEFB
  component "«form»\nCU6 FGestionarHorarios\n(index.blade.php)" as F_CU6_0 #E3EEFB
}
rectangle "Capa de control y negocio (backend/app)" as LC #F7FAF8 {
  component "«class»\nGGestionarEspecialidades\n(EspecialidadController.php)" as C_CU4_0 #E6F5EC
  component "«class»\nGGestionarMedicos\n(MedicoController.php)" as C_CU5_0 #E6F5EC
  component "«class»\nGGestionarHorarios\n(HorarioController.php)" as C_CU6_0 #E6F5EC
}
rectangle "Capa de datos (PostgreSQL)" as LD #FDF8F8 {
  component "«table»\nespecialidades" as T_especialidades #FCE8E8
  component "«table»\nmedicos" as T_medicos #FCE8E8
  component "«table»\nespecialidad_medico" as T_especialidad_medico #FCE8E8
  component "«table»\nusers" as T_users #FCE8E8
  component "«table»\nhorarios" as T_horarios #FCE8E8
  component "«table»\nconfiguracion" as T_configuracion #FCE8E8
}
F_CU4_0 -[hidden]right- F_CU5_0
F_CU5_0 -[hidden]right- F_CU6_0
F_CU4_0 ..> C_CU4_0
C_CU4_0 ..> T_especialidades
F_CU5_0 ..> C_CU5_0
C_CU5_0 ..> T_medicos
C_CU5_0 ..> T_especialidad_medico
C_CU5_0 ..> T_especialidades
C_CU5_0 ..> T_users
F_CU6_0 ..> C_CU6_0
C_CU6_0 ..> T_horarios
C_CU6_0 ..> T_medicos
C_CU6_0 ..> T_configuracion
@enduml
