left to right direction
title CU13 – Registrar asistencia
actor "Recepcionista" as A
boundary "Pantalla Asistencia de Hoy" as B
control "Control Asistencia" as C
entity "Cita" as E0
entity "Historial Cita" as E1
A --> B : 1: abrir asistencia de hoy\n4: marcar «Llegó» / «No asistió»
B --> C : 2: listarCitasDeHoy(medico)\n5: registrar(cita, tipo)
C --> E0 : 3: obtener citas del día\n6: cambiar a CONFIRMADA / INASISTENCIA
C --> E1 : 7: registrar cambio
B <-- C : 8: resultado
A <-- B : 9: mostrar lista actualizada
