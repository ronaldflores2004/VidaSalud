@startuml

set separator none
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam shadowing false
skinparam ArrowColor #333333
skinparam ActorBorderColor #222222
skinparam ActorBackgroundColor #FFFFFF
skinparam UsecaseBorderColor #1F4E79
skinparam UsecaseBackgroundColor #DCE9F7
skinparam PackageBorderColor #333333
skinparam PackageBackgroundColor #FFFFFF
skinparam ClassBorderColor #333333
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassHeaderBackgroundColor #DCE9F7
skinparam NoteBackgroundColor #FFF8DC
skinparam RectangleBorderColor #333333
skinparam NodeBorderColor #1F4E79
skinparam NodeBackgroundColor #F3F8FD
skinparam ArtifactBackgroundColor #FFFFFF
skinparam DatabaseBackgroundColor #DCE9F7
skinparam SequenceLifeLineBorderColor #888888
skinparam SequenceParticipantBackgroundColor #DCE9F7
skinparam SequenceParticipantBorderColor #1F4E79
skinparam ParticipantPadding 12
skinparam BoundaryBackgroundColor #DCE9F7
skinparam ControlBackgroundColor #DCE9F7
skinparam EntityBackgroundColor #DCE9F7
skinparam BoundaryBorderColor #1F4E79
skinparam ControlBorderColor #1F4E79
skinparam EntityBorderColor #1F4E79
skinparam roundcorner 8
allowmixing
left to right direction
hide circle
skinparam classAttributeIconSize 0
actor "Paciente" as A
class "Pantalla Reservar Ficha" as B <<boundary>> {
  especialidad_id: int
  medico_id: int
  fecha: date
  hora_inicio: time
  modalidad: string
  motivo: string
}
class "Control Citas" as C <<control>> {
  + mostrarFormulario()
  + reservar(datos, usuario): Cita
  + mostrarComprobante(cita)
}
class "Paciente" as E0 <<entity>> {
  id: int
  codigo: string
  ci: string
  nombres: string
  apellidos: string
  fecha_nacimiento: date
  sexo: char
  telefono: string
  email: string
  direccion: string
  tipo_sangre: string
  acepta_notificaciones: bool
  activo: bool
  --
  + buscar(texto)
  + siguienteCodigo(): string
  + asegurarHistoria(): HistoriaClinica
  + contactos(): ContactoEmergencia[*]
}
class "Médico" as E1 <<entity>> {
  id: int
  codigo: string
  registro_profesional: string
  nombres: string
  apellidos: string
  telefono: string
  email: string
  activo: bool
  --
  + especialidades()
  + horarios()
  + siguienteCodigo(): string
}
class "Horario" as E2 <<entity>> {
  id: int
  dia_semana: int
  hora_inicio: time
  hora_fin: time
  activo: bool
  --
  + seCruzaCon(inicio, fin): bool
  + duracionFicha(): int
}
class "Cita" as E3 <<entity>> {
  id: int
  codigo: string
  fecha: date
  hora_inicio: time
  hora_fin: time
  modalidad: string
  motivo: string
  estado: EstadoCita
  --
  + siguienteCodigo(): string
}
A --> B
B --> C
C --> E0
C --> E1
C --> E2
C --> E3
E1 "1" -- "0..*" E2 : tiene
E0 "1" -- "0..*" E3 : solicita
E1 "1" -- "0..*" E3 : atiende
E2 "1" -- "0..*" E3 : ofrece fichas
E1 "1" -- "0..*" E3 : atiende
@enduml
