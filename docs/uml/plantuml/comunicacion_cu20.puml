left to right direction
title CU20 – Generar reportes
actor "Administrador" as A
boundary "Pantalla Reportes" as B
control "Control Reportes" as C
entity "Cita" as E0
entity "Paciente" as E1
entity "Médico" as E2
A --> B : 1: tipo de reporte y filtros\n8: exportar PDF / Excel
B --> C : 2: generar(filtros)\n9: exportar(formato)
C --> E0 : 3: obtener citas del período
C --> E1 : 4: obtener pacientes registrados
C --> E2 : 5: agrupar atenciones por médico
B <-- C : 6: datos y totales\n10: archivo
A <-- B : 7: mostrar vista previa\n11: descargar archivo
