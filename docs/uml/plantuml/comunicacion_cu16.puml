left to right direction
title CU16 – Gestionar historial clínico
actor "Médico" as A
boundary "Pantalla Historial Clínico" as B
control "Control Historial" as C
entity "Paciente" as E0
entity "Historia Clínica" as E1
entity "Consulta" as E2
A --> B : 1: abrir historial del paciente\n6: actualizar antecedentes
B --> C : 2: mostrar(paciente)\n7: actualizar(datos)
C --> E0 : 3: verificar que es su paciente
C --> E1 : 4: obtener antecedentes\n8: guardar
C --> E2 : 5: obtener consultas, tratamientos y estudios
B <-- C : 9: resultado
A <-- B : 10: mostrar historial actualizado
