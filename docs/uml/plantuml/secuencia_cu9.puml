@startuml

set separator none
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam shadowing false
skinparam ArrowColor #333333
skinparam ActorBorderColor #222222
skinparam ActorBackgroundColor #FFFFFF
skinparam UsecaseBorderColor #1F4E79
skinparam UsecaseBackgroundColor #DCE9F7
skinparam PackageBorderColor #333333
skinparam PackageBackgroundColor #FFFFFF
skinparam ClassBorderColor #333333
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassHeaderBackgroundColor #DCE9F7
skinparam NoteBackgroundColor #FFF8DC
skinparam RectangleBorderColor #333333
skinparam NodeBorderColor #1F4E79
skinparam NodeBackgroundColor #F3F8FD
skinparam ArtifactBackgroundColor #FFFFFF
skinparam DatabaseBackgroundColor #DCE9F7
skinparam SequenceLifeLineBorderColor #888888
skinparam SequenceParticipantBackgroundColor #DCE9F7
skinparam SequenceParticipantBorderColor #1F4E79
skinparam ParticipantPadding 12
skinparam BoundaryBackgroundColor #DCE9F7
skinparam ControlBackgroundColor #DCE9F7
skinparam EntityBackgroundColor #DCE9F7
skinparam BoundaryBorderColor #1F4E79
skinparam ControlBorderColor #1F4E79
skinparam EntityBorderColor #1F4E79
skinparam roundcorner 8
skinparam SequenceParticipantBackgroundColor #FBF4E4
skinparam SequenceParticipantBorderColor #555555
skinparam SequenceLifeLineBorderColor #555555
skinparam SequenceGroupBackgroundColor #F2F2F2
skinparam SequenceGroupBorderColor #555555
skinparam ActorBackgroundColor #FFFFFF
skinparam ArrowColor #222222
skinparam sequenceMessageAlign left
skinparam maxMessageSize 220
hide footbox

mainframe **sd CU9_ConsultarDisponibilidadDeHorarios**
actor "Paciente" as A
participant ":ConsultarDisponibilidad" as F <<frm>>
participant ":CtrlDisponibilidad" as C <<ctrl>>
participant ":Especialidad" as E1 <<entidad>>
participant ":Medico" as E2 <<entidad>>
participant ":Horario" as E3 <<entidad>>
participant ":Cita" as E4 <<entidad>>
A -> F : seleccionarEspecialidad(esp)
activate F
F -> C : medicosPorEspecialidad(esp)
activate C
C -> E1 : medicosActivos()
activate E1
E1 --> C : médicos
C --> F : médicos y días
A -> F : seleccionarMedicoYFecha(medico, fecha)
F -> C : bloques(medico, fecha)
C -> E2 : estaActivo()
activate E2
E2 --> C : true
C -> E3 : horariosDelDia(fecha)
activate E3
E3 --> C : horarios
C -> E4 : citasNoCanceladas(medico, fecha)
activate E4
E4 --> C : ocupadas
loop por cada horario, cada 15 minutos
C -> C : marcarFicha(libre | ocupada)
end
C --> F : fichas
F --> A : mostrarFichasDisponibles()
deactivate F
deactivate E4
deactivate E3
deactivate E2
deactivate E1
deactivate C
@enduml
