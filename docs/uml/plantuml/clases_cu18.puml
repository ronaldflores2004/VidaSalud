@startuml

set separator none
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam shadowing false
skinparam ArrowColor #333333
skinparam ActorBorderColor #222222
skinparam ActorBackgroundColor #FFFFFF
skinparam UsecaseBorderColor #1F4E79
skinparam UsecaseBackgroundColor #DCE9F7
skinparam PackageBorderColor #333333
skinparam PackageBackgroundColor #FFFFFF
skinparam ClassBorderColor #333333
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassHeaderBackgroundColor #DCE9F7
skinparam NoteBackgroundColor #FFF8DC
skinparam RectangleBorderColor #333333
skinparam NodeBorderColor #1F4E79
skinparam NodeBackgroundColor #F3F8FD
skinparam ArtifactBackgroundColor #FFFFFF
skinparam DatabaseBackgroundColor #DCE9F7
skinparam SequenceLifeLineBorderColor #888888
skinparam SequenceParticipantBackgroundColor #DCE9F7
skinparam SequenceParticipantBorderColor #1F4E79
skinparam ParticipantPadding 12
skinparam BoundaryBackgroundColor #DCE9F7
skinparam ControlBackgroundColor #DCE9F7
skinparam EntityBackgroundColor #DCE9F7
skinparam BoundaryBorderColor #1F4E79
skinparam ControlBorderColor #1F4E79
skinparam EntityBorderColor #1F4E79
skinparam roundcorner 8
allowmixing
left to right direction
hide circle
skinparam classAttributeIconSize 0
actor "Médico" as A
class "Pantalla Estudios" as B <<boundary>> {
  catalogo_estudio_id
  indicaciones
  estado
  fecha_resultado
  resultado
  archivo
}
class "Control Estudios" as C <<control>> {
  + solicitar(consulta, estudio)
  + registrarResultado(estudio, datos, archivo)
  + descargarArchivo(estudio)
  + pendientes(medico)
}
class "Consulta" as E0 <<entity>> {
  id: int
  fecha_hora: datetime
  motivo_consulta: string
  peso_kg: decimal
  talla_cm: decimal
  presion_arterial: string
  temperatura_c: decimal
  frecuencia_cardiaca: int
  examen_fisico: text
  diagnostico: text
  observaciones: text
  --
  + imc(): decimal
  + tratamientos()
  + estudios()
}
class "Catálogo Estudio" as E1 <<entity>> {
  id: int
  nombre: string
  categoria: string
  activo: bool
  --
  + activos()
}
class "Estudio" as E2 <<entity>> {
  id: int
  indicaciones: string
  estado: string
  fecha_solicitud: date
  fecha_resultado: date
  resultado: text
  archivo_resultado: string
  --
  + tieneResultado(): bool
  + registrarResultado(datos)
}
class "Notificación" as E3 <<entity>> {
  id: int
  tipo: string
  canal: string
  mensaje: string
  para_medico: bool
  programada_para: datetime
  enviada_en: datetime
  leida_en: datetime
  --
  + destinatario(): Usuario
  + url(): string
  + marcarLeida()
}
A --> B
B --> C
C --> E0
C --> E1
C --> E2
C --> E3
E0 "1" -- "0..*" E2 : solicita
E1 "1" -- "0..*" E2 : clasifica
E2 "0..1" -- "0..*" E3 : genera
@enduml
