hide footbox

mainframe **sd CU13_RegistrarAsistencia**
actor "Recepcionista" as A
participant ":RegistrarAsistencia" as F <<frm>>
participant ":CtrlAsistencia" as C <<ctrl>>
participant ":Cita" as E1 <<entidad>>
participant ":HistorialCita" as E2 <<entidad>>
A -> F : abrirAsistenciaDeHoy(medico)
activate F
F -> C : citasDeHoy(medico)
activate C
C -> E1 : listar(hoy, medico)
activate E1
E1 --> C : citas
C --> F : citas y resumen
A -> F : marcar(cita, tipo)
F -> C : registrar(cita, tipo)
C -> E1 : esDeHoyYProgramada()
E1 --> C : resultado
alt tipo = LLEGADA
C -> E1 : cambiarEstado(CONFIRMADA)
C -> E2 : registrar(CONFIRMADA)
activate E2
else tipo = INASISTENCIA y ya pasó la hora
C -> E1 : cambiarEstado(INASISTENCIA)
C -> E2 : registrar(INASISTENCIA)
else no es de hoy o aún no es la hora
C --> F : error
end
C --> F : resultado
F --> A : mostrarListaActualizada()
deactivate F
deactivate E2
deactivate E1
deactivate C
@enduml
