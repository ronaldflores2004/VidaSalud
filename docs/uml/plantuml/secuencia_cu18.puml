hide footbox

mainframe **sd CU18_GestionarEstudiosMédicos**
actor "Medico" as A
participant ":GestionarEstudios" as F <<frm>>
participant ":CtrlEstudios" as C <<ctrl>>
participant ":Consulta" as E1 <<entidad>>
participant ":CatalogoEstudio" as E2 <<entidad>>
participant ":Estudio" as E3 <<entidad>>
participant ":Notificacion" as E4 <<entidad>>
A -> F : solicitarEstudio(estudio, indicaciones)
activate F
F -> C : solicitar(consulta, estudio)
activate C
C -> E2 : existe(estudio)
activate E2
E2 --> C : estudio
C -> E3 : pendienteEnConsulta(estudio)
activate E3
E3 --> C : resultado
alt no está pendiente
C -> E3 : crear(SOLICITADO, hoy)
C --> F : estudio solicitado
else ya está solicitado
C --> F : no se repite
end
A -> F : registrarResultado(estado, fecha, resultado, archivo)
F -> C : registrarResultado(estudio, datos, archivo)
C -> C : validarArchivo(pdf | jpg | png <= 4 MB)
C -> E3 : guardarResultado(datos, archivo)
opt primer resultado y el paciente acepta avisos
C -> E4 : crear(RESULTADO)
activate E4
end
C --> F : resultado registrado
F --> A : mostrarConsulta()
deactivate F
deactivate E4
deactivate E3
deactivate E2
deactivate C
@enduml
