skinparam EntityBackgroundColor #DCE9F7
skinparam BoundaryBorderColor #1F4E79
skinparam ControlBorderColor #1F4E79
skinparam EntityBorderColor #1F4E79
skinparam roundcorner 8
left to right direction
title CU19 – Consultar historial y resultados
actor "Paciente" as A
boundary "Pantalla Mi Historial" as B
control "Control Mi Historial" as C
entity "Paciente" as E0
entity "Consulta" as E1
entity "Estudio" as E2
entity "Notificación" as E3
A --> B : 1: abrir mi historial
B --> C : 2: miHistorial(usuario)
C --> E0 : 3: identificar paciente
C --> E1 : 4: obtener consultas y tratamientos
C --> E2 : 5: obtener estudios y resultados
C --> E3 : 6: obtener avisos y marcarlos leídos
B <-- C : 7: historial
A <-- B : 8: mostrar historial y resultados
@enduml
