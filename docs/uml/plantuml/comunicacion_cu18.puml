left to right direction
title CU18 – Gestionar estudios médicos
actor "Médico" as A
boundary "Pantalla Estudios" as B
control "Control Estudios" as C
entity "Consulta" as E0
entity "Catálogo Estudio" as E1
entity "Estudio" as E2
entity "Notificación" as E3
A --> B : 1: solicitar estudio / registrar resultado
B --> C : 2: solicitar(consulta, estudio)\n6: registrarResultado(estudio, datos, archivo)
C --> E1 : 3: validar estudio del catálogo
C --> E2 : 4: verificar que no esté pendiente\n5: guardar estudio SOLICITADO\n7: guardar resultado y archivo
C --> E3 : 8: avisar al paciente
B <-- C : 9: resultado
A <-- B : 10: mostrar estudios
@enduml
