title Ciclo II – Pagos y notificaciones (CU21, CU22)
rectangle "Reservar ficha\nCU10" as RF
rectangle "Pagar ficha\nCU21" as PG
rectangle "Ventana de PayPal" as PP
rectangle "Detalle de la cita\n(Pagada)" as DC
rectangle "Asistencia de hoy\nCU13" as AS
rectangle "Pagos\nCU21 (recepción)" as LP
rectangle "Notificaciones\nCU22" as NO
rectangle "Permiso del navegador" as PE
rectangle "Notificación push" as NP
RF --> PG : Confirmar (paciente)
PG --> PP : Pagar con PayPal
PP --> DC : pago aprobado
PG --> DC : Pagar después en recepción
AS --> AS : Cobrar (efectivo, QR, tarjeta)
AS --> LP : Pagos
LP --> LP : Reembolsar
NO --> PE : Activar notificaciones
PE --> NO : permitido
NP --> DC : tocar la notificación

@enduml
