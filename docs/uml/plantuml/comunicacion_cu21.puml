left to right direction
title CU21 – Pagar ficha
actor "Paciente" as A
boundary "Pantalla Pagar Ficha" as B
control "Control Pagos" as C
entity "Cita" as E0
entity "Pago" as E1
entity "PayPal" as E2
entity "Notificación" as E3
A --> B : 1: pagar con PayPal
B --> C : 2: crearOrden(cita)\n6: capturar(cita, orden)
C --> E0 : 3: verificar ficha vigente sin pago
C --> E2 : 4: crear orden (USD)\n7: capturar y verificar monto
A --> E2 : 5: aprobar pago
C --> E1 : 8: registrar pago
C --> E3 : 9: avisar al paciente
B <-- C : 10: ficha pagada
A <-- B : 11: mostrar ficha «Pagada»
@enduml
