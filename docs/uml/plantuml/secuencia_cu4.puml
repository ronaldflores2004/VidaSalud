hide footbox

mainframe **sd CU4_GestionarEspecialidades**
actor "Administrador" as A
participant ":GestionarEspecialidades" as F <<frm>>
participant ":CtrlGestionarEspecialidades" as C <<ctrl>>
participant ":Especialidad" as E1 <<entidad>>
A -> F : ingresarDatos(nombre, descripcion)
activate F
F -> F : validarCampos()
F -> C : registrar(datos)
activate C
C -> E1 : nombreRepetido(nombre)
activate E1
E1 --> C : existe
alt el nombre no existe
C -> E1 : crear(datos)
E1 --> C : especialidad
C --> F : especialidad registrada
F --> A : mostrarConfirmacion()
else nombre repetido (sin importar tildes ni mayúsculas)
C --> F : ya existe
F --> A : mostrarMensaje(error)
end
deactivate F
deactivate E1
deactivate C
@enduml
