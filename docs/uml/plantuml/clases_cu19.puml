@startuml

set separator none
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam shadowing false
skinparam ArrowColor #333333
skinparam ActorBorderColor #222222
skinparam ActorBackgroundColor #FFFFFF
skinparam UsecaseBorderColor #1F4E79
skinparam UsecaseBackgroundColor #DCE9F7
skinparam PackageBorderColor #333333
skinparam PackageBackgroundColor #FFFFFF
skinparam ClassBorderColor #333333
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassHeaderBackgroundColor #DCE9F7
skinparam NoteBackgroundColor #FFF8DC
skinparam RectangleBorderColor #333333
skinparam NodeBorderColor #1F4E79
skinparam NodeBackgroundColor #F3F8FD
skinparam ArtifactBackgroundColor #FFFFFF
skinparam DatabaseBackgroundColor #DCE9F7
skinparam SequenceLifeLineBorderColor #888888
skinparam SequenceParticipantBackgroundColor #DCE9F7
skinparam SequenceParticipantBorderColor #1F4E79
skinparam ParticipantPadding 12
skinparam BoundaryBackgroundColor #DCE9F7
skinparam ControlBackgroundColor #DCE9F7
skinparam EntityBackgroundColor #DCE9F7
skinparam BoundaryBorderColor #1F4E79
skinparam ControlBorderColor #1F4E79
skinparam EntityBorderColor #1F4E79
skinparam roundcorner 8
allowmixing
left to right direction
hide circle
skinparam classAttributeIconSize 0
actor "Paciente" as A
class "Pantalla Mi Historial" as B <<boundary>> {
  (solo lectura)
}
class "Control Mi Historial" as C <<control>> {
  + miHistorial(paciente)
  + marcarAvisosLeidos()
  + descargarArchivo(estudio)
}
class "Paciente" as E0 <<entity>> {
  id: int
  codigo: string
  ci: string
  nombres: string
  apellidos: string
  fecha_nacimiento: date
  sexo: char
  telefono: string
  email: string
  direccion: string
  tipo_sangre: string
  acepta_notificaciones: bool
  activo: bool
  --
  + buscar(texto)
  + siguienteCodigo(): string
  + asegurarHistoria(): HistoriaClinica
  + contactos(): ContactoEmergencia[*]
}
class "Consulta" as E1 <<entity>> {
  id: int
  fecha_hora: datetime
  motivo_consulta: string
  peso_kg: decimal
  talla_cm: decimal
  presion_arterial: string
  temperatura_c: decimal
  frecuencia_cardiaca: int
  examen_fisico: text
  diagnostico: text
  observaciones: text
  --
  + imc(): decimal
  + tratamientos()
  + estudios()
}
class "Estudio" as E2 <<entity>> {
  id: int
  indicaciones: string
  estado: string
  fecha_solicitud: date
  fecha_resultado: date
  resultado: text
  archivo_resultado: string
  --
  + tieneResultado(): bool
  + registrarResultado(datos)
}
class "Notificación" as E3 <<entity>> {
  id: int
  tipo: string
  canal: string
  mensaje: string
  para_medico: bool
  programada_para: datetime
  enviada_en: datetime
  leida_en: datetime
  --
  + destinatario(): Usuario
  + url(): string
  + marcarLeida()
}
A --> B
B --> C
C --> E0
C --> E1
C --> E2
C --> E3
E1 "1" -- "0..*" E2 : solicita
E2 "0..1" -- "0..*" E3 : genera
E0 "1" -- "0..*" E1 : recibe
@enduml
