left to right direction
title CU6 – Gestionar horarios de atención
actor "Administrador" as A
boundary "Pantalla Horarios" as B
control "Control Horarios" as C
entity "Horario" as E0
entity "Médico" as E1
A --> B : 1: ingresar día, horas y duración
B --> C : 2: registrar(medico, bloque)
C --> E1 : 3: obtener médico
C --> E0 : 4: verificar cruce con bloques del día\n5: guardar bloque
B <-- C : 6: resultado
A <-- B : 7: mostrar semana actualizada
