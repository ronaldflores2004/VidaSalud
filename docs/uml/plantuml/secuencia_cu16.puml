hide footbox

mainframe **sd CU16_GestionarHistorialClínico**
actor "Medico" as A
participant ":HistorialClinico" as F <<frm>>
participant ":CtrlHistorialClinico" as C <<ctrl>>
participant ":Medico" as E1 <<entidad>>
participant ":Paciente" as E2 <<entidad>>
participant ":HistoriaClinica" as E3 <<entidad>>
participant ":Consulta" as E4 <<entidad>>
A -> F : abrirHistorial(paciente)
activate F
F -> C : mostrar(paciente)
activate C
C -> E1 : atiendeA(paciente)
activate E1
E1 --> C : resultado
alt es su paciente
C -> E3 : obtener()
activate E3
E3 --> C : antecedentes
C -> E4 : consultasConTratamientosYEstudios()
activate E4
E4 --> C : consultas
C --> F : historial
F --> A : mostrarHistorial()
opt actualizar antecedentes
A -> F : editarAntecedentes(datos)
F -> C : actualizar(paciente, datos)
C -> E3 : actualizar(datos)
C --> F : historial actualizado
end
else no es su paciente
C --> F : acceso denegado (403)
end
deactivate F
deactivate E4
deactivate E3
deactivate E1
deactivate C
@enduml
