  component "«form»\nCU7 FGestionarPacientes\n(index, form,\nshow.blade.php)" as F_CU7_0 #E3EEFB
  component "«form»\nCU8 FRegistrarsePaciente\n(registro.blade.php)" as F_CU8_0 #E3EEFB
}
rectangle "Capa de control y negocio (backend/app)" as LC #F7FAF8 {
  component "«class»\nGGestionarPacientes\n(PacienteController.php)" as C_CU7_0 #E6F5EC
  component "«class»\nGRegistrarsePaciente\n(RegistroPacienteController.php)" as C_CU8_0 #E6F5EC
}
rectangle "Capa de datos (PostgreSQL)" as LD #FDF8F8 {
  component "«table»\npacientes" as T_pacientes #FCE8E8
  component "«table»\nhistorias_clinicas" as T_historias_clinicas #FCE8E8
  component "«table»\ncontactos_emergencia" as T_contactos_emergencia #FCE8E8
  component "«table»\nusers" as T_users #FCE8E8
  component "«table»\nroles" as T_roles #FCE8E8
}
F_CU7_0 -[hidden]right- F_CU8_0
F_CU7_0 ..> C_CU7_0
C_CU7_0 ..> T_pacientes
C_CU7_0 ..> T_historias_clinicas
C_CU7_0 ..> T_contactos_emergencia
F_CU8_0 ..> C_CU8_0
C_CU8_0 ..> T_pacientes
C_CU8_0 ..> T_users
