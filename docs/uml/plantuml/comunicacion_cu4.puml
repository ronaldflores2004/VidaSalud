left to right direction
title CU4 – Gestionar especialidades
actor "Administrador" as A
boundary "Pantalla Especialidades" as B
control "Control Especialidades" as C
entity "Especialidad" as E0
A --> B : 1: ingresar nombre y descripción
B --> C : 2: registrar(datos)
C --> C : 3: normalizar nombre
C --> E0 : 4: verificar nombre único\n5: guardar
B <-- C : 6: resultado
A <-- B : 7: mostrar confirmación
