title Ciclo II – Paciente y administrador
rectangle "Panel del paciente\n(avisos nuevos)" as PD
rectangle "Mi historial\nCU19" as PH
rectangle "Archivo del resultado\n(PDF / imagen)" as PF
rectangle "Mis citas" as PC
rectangle "Detalle de la cita" as PCD
rectangle "Cancelar cita\nCU12" as PX
rectangle "Reprogramar cita\nCU11 (RN18)" as PR
rectangle "Política de citas\nCU6 (RN17–RN20)" as AO
rectangle "Panel del administrador" as AD
rectangle "Reportes\nCU20 (vista previa)" as AR
rectangle "Reporte .pdf" as AP
rectangle "Reporte .xlsx" as AE
PD --> PH : Mi historial
PH --> PF : Descargar archivo
PD --> PC : Mis citas
PC --> PCD : ver cita
PCD --> PX : Cancelar cita
PX --> PCD : Confirmar
PCD --> PR : Reprogramar
PR --> PCD : Guardar
AD --> AO : Política de citas
AO --> AO : Guardar plazos
AD --> AR : Reportes
AR --> AR : Ver reporte (filtros)
AR --> AP : Exportar PDF
AR --> AE : Exportar Excel

@enduml
