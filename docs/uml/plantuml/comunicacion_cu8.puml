skinparam EntityBorderColor #1F4E79
skinparam roundcorner 8
left to right direction
title CU8 – Registrarse como paciente
actor "Paciente" as A
boundary "Pantalla Registro de Paciente" as B
control "Control Registro" as C
entity "Usuario" as E0
entity "Paciente" as E1
entity "Rol" as E2
A --> B : 1: ingresar CI, datos, correo y contraseña
B --> C : 2: registrar(datos)
C --> E1 : 3: buscar paciente por CI\n7: crear o vincular paciente
C --> E0 : 4: verificar correo y CI sin cuenta\n6: crear cuenta con hash de contraseña
C --> E2 : 5: obtener perfil Paciente
B <-- C : 8: cuenta creada / error
A <-- B : 9: mostrar panel del paciente
@enduml
